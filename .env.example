# Copy this file to .env and fill in real values. .env is gitignored —
# never commit actual credentials.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely (unlike
# VendorHub's public anon key, which can only INSERT). Get it from the
# VendorHub Supabase project's dashboard: Project Settings -> API ->
# service_role key. Treat it like a database password.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without it, treaty-rate lookups use only the static sample
# table (wht_engine/treaty_rates.py) -- a miss there just falls back to
# the 30% statutory rate, same as always. With it set, a miss instead
# triggers a live fetch of the real IRS Table 1 + Table 3 PDFs, read by
# Claude -- see adapters/live_treaty_lookup.py.
ANTHROPIC_API_KEY=


# Optional local W-8 PDF extraction: choose a model enabled for your account.
WHT_AGENT_MODEL=
